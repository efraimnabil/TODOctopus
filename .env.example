# Neon Postgres connection string
DATABASE_URL=
# openssl rand -base64 32
BETTER_AUTH_SECRET=
# The site's own URL
BETTER_AUTH_URL=http://localhost:3000
# Any long random string; Vercel sends it as a bearer token to the cron route
CRON_SECRET=
# Optional: public URL used by the sitemap and social cards
# NEXT_PUBLIC_SITE_URL=https://example.com

# AI features (all optional). Without a key the AI buttons are hidden.
ANTHROPIC_API_KEY=
# Set to 0 to switch every AI feature off
# AI_ENABLED=0
# Set to 1 to answer from canned data instead of calling the model (tests only)
# AI_MOCK=1
